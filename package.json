{
  "name": "turath-backend",
  "version": "0.0.1",
  "description": "Turath (تراث) backend — NestJS microservices",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build api-gateway && nest build identity",
    "build:gateway": "nest build api-gateway",
    "build:identity": "nest build identity",
    "start:gateway": "nest start api-gateway --watch",
    "start:identity": "nest start identity --watch",
    "start:prod:gateway": "node dist/apps/api-gateway/main.js",
    "start:prod:identity": "node dist/apps/identity/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "oxlint apps/ libs/",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:integration": "vitest run --project integration",
    "test:smoke": "vitest run --project smoke",
    "test:all": "vitest run --project unit --project e2e --project integration",
    "test:cov": "vitest run --project unit --coverage",
    "prisma:identity": "prisma --config apps/identity/prisma.config.ts",
    "db:generate": "npm run prisma:identity -- generate",
    "db:studio": "npm run prisma:identity -- studio",
    "db:migrate:dev": "npm run prisma:identity -- migrate dev",
    "db:migrate:deploy": "npm run prisma:identity -- migrate deploy",
    "postinstall": "npm run db:generate",
    "admin:key": "node -e \"console.log(require('node:crypto').randomBytes(48).toString('base64url'))\"",
    "docker:up": "docker compose up -d --build",
    "docker:infra": "docker compose up -d postgres redis rabbitmq",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@keyv/redis": "^5.1.6",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/microservices": "^12.1.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@redis/client": "^5.12.1",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "argon2": "^0.45.1",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "joi": "^18.2.9",
    "keyv": "^5.6.0",
    "libphonenumber-js": "^1.13.14",
    "nestjs-i18n": "^10.8.5",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@rspack/core": "^2.2.7",
    "@swc/core": "^1.16.2",
    "@types/amqplib": "^0.10.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "dotenv": "^18.0.4",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.2",
    "webpack-node-externals": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
