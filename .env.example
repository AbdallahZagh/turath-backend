# Copy to .env. These values are for running the apps on your machine
# (`npm run start:gateway` / `npm run start:identity`) against the Docker infra
# (`npm run docker:infra`). docker-compose.yml overrides the hostnames itself.

NODE_ENV=development

# ── shared ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://turath:turath@localhost:5672
# At least 32 characters. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# ── api-gateway ─────────────────────────────────────────
PORT=4000
# Comma-separated list of frontend origins allowed to send cookies
CORS_ORIGINS=http://localhost:3000
# e.g. .turath.sy in production so turath.sy and api.turath.sy share cookies
COOKIE_DOMAIN=
COOKIE_SECURE=false
# Number of reverse proxies in front of the gateway (Nginx / LB). 0 = use the socket IP.
# Only set this when a proxy you control overwrites X-Forwarded-For, or clients can spoof their IP.
TRUST_PROXY=0
SWAGGER_ENABLED=true
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
CACHE_TTL_SECONDS=60
RPC_TIMEOUT_MS=5000

# ── admin API (private, not in Swagger) ─────────────────
# Comma-separated keys for /api/v1/admin/*, sent as the `x-api-key` header.
# Empty = admin API disabled (every route answers 404). Each key: at least 32 characters.
# Generate one: npm run admin:key
ADMIN_API_KEYS=

# ── identity ────────────────────────────────────────────
IDENTITY_DATABASE_URL=postgresql://turath:turath@localhost:5432/turath_identity
IDENTITY_HEALTH_PORT=4001
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
RESET_TOKEN_TTL_SECONDS=600
# Returns the OTP / reset token in API responses. NEVER enable outside local dev.
OTP_DEV_ECHO=true

# ── docker-compose ──────────────────────────────────────
POSTGRES_USER=turath
POSTGRES_PASSWORD=turath
RABBITMQ_USER=turath
RABBITMQ_PASSWORD=turath
