// Identity service database (turath_identity). Each microservice owns its own
// database; other services refer to users by id only, never by foreign key.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TOURIST
  PROVIDER_STAFF
  PROVIDER_OWNER
  SUPER_ADMIN
}

/// Kind of business a provider account runs. Null for tourists.
enum ProviderType {
  RESTAURANT
  HOTEL
  TRIP_AGENCY
  EVENT_MANAGER
  TOUR_GUIDE
}

enum Locale {
  en
  ar
}

enum Theme {
  light
  dark
  system
}

model User {
  id               String        @id @default(uuid()) @db.Uuid
  /// E.164, e.g. +963944123456
  phone            String        @unique @db.VarChar(20)
  /// ISO 3166-1 alpha-2 of the phone number
  phoneCountry     String?       @map("phone_country") @db.Char(2)
  /// Stored lower-case
  email            String?       @unique @db.VarChar(150)
  /// Null for phone-only accounts
  passwordHash     String?       @map("password_hash")
  fullName         String        @map("full_name") @db.VarChar(100)
  dateOfBirth      DateTime?     @map("date_of_birth") @db.Date
  /// ISO 3166-1 alpha-2
  nationality      String?       @db.Char(2)
  role             UserRole      @default(TOURIST)
  providerType     ProviderType? @map("provider_type")
  /// 0–100, starts at 100, −30 per no-show (see SRS FR-AUTH-04)
  reliabilityScore Int           @default(100) @map("reliability_score")
  preferredLocale  Locale        @default(en) @map("preferred_locale")
  preferredTheme   Theme         @default(system) @map("preferred_theme")
  phoneVerifiedAt  DateTime?     @map("phone_verified_at") @db.Timestamptz(6)
  emailVerifiedAt  DateTime?     @map("email_verified_at") @db.Timestamptz(6)
  lockedAt         DateTime?     @map("locked_at") @db.Timestamptz(6)
  lastLoginAt      DateTime?     @map("last_login_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([role])
  @@map("users")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  SUPPORT
}

/// Back-office staff. Separate from `users`: no phone, no tourist profile.
/// Created only through the private admin API (x-api-key).
model Admin {
  id           String    @id @default(uuid()) @db.Uuid
  fullName     String    @map("full_name") @db.VarChar(100)
  /// Stored lower-case
  email        String    @unique @db.VarChar(150)
  passwordHash String    @map("password_hash")
  role         AdminRole @default(ADMIN)
  /// Values from ADMIN_PERMISSIONS in libs/contracts
  permissions  String[]  @default([])
  lockedAt     DateTime? @map("locked_at") @db.Timestamptz(6)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([role])
  @@map("admins")
}

enum ReviewAbout {
  PROVIDER
  GUEST
}

enum ReviewStatus {
  PUBLISHED
  FLAGGED
  HIDDEN
}

/// A rating left after a booking, moderated from the admin dashboard.
/// Names are copied onto the row so a review still reads correctly if the
/// account changes; `subjectId` / `authorId` link to `users` by id only.
model Review {
  id           String       @id @default(uuid()) @db.Uuid
  about        ReviewAbout
  /// The provider or guest being rated. Null until providers exist as accounts.
  subjectId    String?      @map("subject_id") @db.Uuid
  /// English name of the provider or guest being rated
  subjectName  String       @map("subject_name") @db.VarChar(150)
  authorId     String?      @map("author_id") @db.Uuid
  authorNameEn String       @map("author_name_en") @db.VarChar(100)
  authorNameAr String       @map("author_name_ar") @db.VarChar(100)
  /// 1–5
  stars        Int
  bodyEn       String       @map("body_en") @db.VarChar(2000)
  bodyAr       String       @map("body_ar") @db.VarChar(2000)
  /// The booking this review is about (owned by the booking service)
  bookingCode  String       @map("booking_code") @db.VarChar(12)
  status       ReviewStatus @default(PUBLISHED)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([about, subjectId])
  @@index([status])
  @@index([createdAt])
  @@map("reviews")
}

enum BookingCategory {
  HOTELS
  DINING
  TRIPS
  EVENTS
  GUIDES
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
  DISPUTED
}

/// A reservation shown in the admin bookings table. Names and phone are copied
/// onto the row so it still reads correctly if an account changes; `guestId` /
/// `providerId` link to accounts by id only. Amounts are whole Syrian pounds.
model Booking {
  id                String          @id @default(uuid()) @db.Uuid
  /// What the guest shows on arrival, 6 characters (A–Z, 0–9)
  code              String          @unique @db.VarChar(12)
  guestId           String?         @map("guest_id") @db.Uuid
  guestNameEn       String          @map("guest_name_en") @db.VarChar(100)
  guestNameAr       String          @map("guest_name_ar") @db.VarChar(100)
  /// E.164, e.g. +963933441208
  guestPhone        String          @map("guest_phone") @db.VarChar(20)
  /// Null until providers exist as accounts
  providerId        String?         @map("provider_id") @db.Uuid
  providerNameEn    String          @map("provider_name_en") @db.VarChar(150)
  providerNameAr    String          @map("provider_name_ar") @db.VarChar(150)
  category          BookingCategory
  /// First day (check-in, or the day of the visit)
  startDate         DateTime        @map("start_date") @db.Date
  /// Last day, for stays
  endDate           DateTime?       @map("end_date") @db.Date
  /// `HH:mm` (24h), for dining, events and guides
  startTime         String?         @map("start_time") @db.VarChar(5)
  /// What the guest pays, after any discount
  amountSyp         Int             @map("amount_syp")
  couponCode        String?         @map("coupon_code") @db.VarChar(40)
  discountSyp       Int?            @map("discount_syp")
  /// Price before the discount
  originalAmountSyp Int?            @map("original_amount_syp")
  status            BookingStatus   @default(PENDING)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@index([status])
  @@index([category])
  @@index([guestId])
  @@index([guestPhone])
  @@map("bookings")
}

enum ProviderStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum Governorate {
  DAMASCUS
  ALEPPO
  LATAKIA
  TARTUS
  HOMS
  HAMA
  PALMYRA
  BOSRA
}

/// Commission axis (rates live in the fees settings)
enum CommissionTier {
  PREFERRED
  STANDARD
  HIGH_RISK
}

/// Credit-ceiling axis, separate from the commission tier
enum CreditTier {
  NEW
  ESTABLISHED
  ENTERPRISE
}

enum ProviderDocumentKind {
  COMMERCIAL_REGISTRATION
  MINISTRY_LICENSE
  OWNER_ID
}

enum ProviderAccountEventKind {
  SUBMITTED
  APPROVED
  REJECTED
  SUSPENDED
  REINSTATED
  FINANCE_UPDATED
}

/// A business that applied to list on the platform, reviewed from the admin
/// dashboard. `category` uses the same five kinds as bookings. Bookings and
/// reviews point at a provider by `providerId` / `subjectId` or, for older rows,
/// by the English name.
model Provider {
  id                 String          @id @default(uuid()) @db.Uuid
  nameEn             String          @map("name_en") @db.VarChar(150)
  nameAr             String          @map("name_ar") @db.VarChar(150)
  ownerEn            String          @map("owner_en") @db.VarChar(100)
  ownerAr            String          @map("owner_ar") @db.VarChar(100)
  category           BookingCategory
  governorate        Governorate
  status             ProviderStatus  @default(PENDING)
  /// Day the application was submitted
  submittedAt        DateTime        @map("submitted_at") @db.Date
  /// E.164, e.g. +963931133207
  phone              String          @db.VarChar(20)
  /// Stored lower-case
  email              String          @db.VarChar(150)
  addressEn          String          @map("address_en") @db.VarChar(250)
  addressAr          String          @map("address_ar") @db.VarChar(250)
  descriptionEn      String          @map("description_en") @db.VarChar(2000)
  descriptionAr      String          @map("description_ar") @db.VarChar(2000)
  tier               CommissionTier  @default(STANDARD)
  creditTier         CreditTier      @default(NEW) @map("credit_tier")
  /// Replaces the tier's commission rate when set, as a fraction (0.1 = 10%)
  commissionOverride Decimal?        @map("commission_override") @db.Decimal(5, 4)
  /// Replaces the credit tier's ceiling when set
  creditOverrideSyp  Int?            @map("credit_override_syp")
  /// What the provider sells; the shape depends on `category` (see ProviderInventory in libs/contracts)
  inventory          Json
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  documents     ProviderDocument[]
  accountEvents ProviderAccountEvent[]

  @@index([status, submittedAt])
  @@index([category])
  @@index([governorate])
  @@index([nameEn])
  @@map("providers")
}

model ProviderDocument {
  id         String               @id @default(uuid()) @db.Uuid
  providerId String               @map("provider_id") @db.Uuid
  kind       ProviderDocumentKind
  filename   String               @db.VarChar(200)
  uploadedAt DateTime             @map("uploaded_at") @db.Date
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("provider_documents")
}

/// The provider's account history (applied, approved, suspended…), oldest first.
model ProviderAccountEvent {
  id         String                   @id @default(uuid()) @db.Uuid
  providerId String                   @map("provider_id") @db.Uuid
  kind       ProviderAccountEventKind
  /// Day it happened
  at         DateTime                 @db.Date
  createdAt  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("provider_account_events")
}

enum DisputeStatus {
  OPEN
  RESOLVED_GUEST
  RESOLVED_PROVIDER
}

/// A disagreement over a booking, settled from the admin dashboard. Names are
/// copied onto the row (like reviews and bookings) and `bookingCode` points at
/// the booking by code. Amounts are whole Syrian pounds.
model Dispute {
  id              String          @id @default(uuid()) @db.Uuid
  bookingCode     String          @map("booking_code") @db.VarChar(12)
  guestNameEn     String          @map("guest_name_en") @db.VarChar(100)
  guestNameAr     String          @map("guest_name_ar") @db.VarChar(100)
  providerNameEn  String          @map("provider_name_en") @db.VarChar(150)
  providerNameAr  String          @map("provider_name_ar") @db.VarChar(150)
  category        BookingCategory
  /// Day the dispute was opened
  openedAt        DateTime        @map("opened_at") @db.Date
  /// The amount in dispute
  amountSyp       Int             @map("amount_syp")
  providerClaimEn String          @map("provider_claim_en") @db.VarChar(1000)
  providerClaimAr String          @map("provider_claim_ar") @db.VarChar(1000)
  touristClaimEn  String          @map("tourist_claim_en") @db.VarChar(1000)
  touristClaimAr  String          @map("tourist_claim_ar") @db.VarChar(1000)
  /// The admin's resolution notes; empty until resolved
  notesEn         String          @default("") @map("notes_en") @db.VarChar(1000)
  notesAr         String          @default("") @map("notes_ar") @db.VarChar(1000)
  status          DisputeStatus   @default(OPEN)
  /// Set when the dispute leaves `OPEN`
  resolvedAt      DateTime?       @map("resolved_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([openedAt])
  @@index([status])
  @@index([category])
  @@index([bookingCode])
  @@map("disputes")
}

enum LedgerStanding {
  HEALTHY
  WATCH
  GRACE
  SUSPENDED
}

enum SettlementCadence {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

/// What a provider owes the platform, shown on the admin accounts page. The name
/// is copied onto the row; `providerId` links to `providers` by id only. Amounts
/// are whole Syrian pounds. Statements are derived from the row, not stored.
model LedgerAccount {
  id               String            @id @default(uuid()) @db.Uuid
  /// Null when the business has no provider record
  providerId       String?           @map("provider_id") @db.Uuid
  providerNameEn   String            @map("provider_name_en") @db.VarChar(150)
  providerNameAr   String            @map("provider_name_ar") @db.VarChar(150)
  category         BookingCategory
  /// Commission earned by the platform so far
  accruedSyp       Int               @map("accrued_syp")
  /// What the provider has paid of it
  paidSyp          Int               @map("paid_syp")
  creditCeilingSyp Int               @map("credit_ceiling_syp")
  /// Fraction of the ceiling in use (0.42 = 42%); above 1 means over the ceiling
  creditUsed       Decimal           @default(0) @map("credit_used") @db.Decimal(6, 4)
  cadence          SettlementCadence
  /// Day of the last settlement
  lastSettledAt    DateTime          @map("last_settled_at") @db.Date
  standing         LedgerStanding    @default(HEALTHY)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([standing])
  @@index([category])
  @@index([providerNameEn])
  @@map("ledger_accounts")
}

/// Platform-wide fee settings: always exactly one row (`id = 1`).
model FeeSettings {
  id        Int      @id @default(1)
  /// Syrian pounds per one US dollar
  sypPerUsd Int      @map("syp_per_usd")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("fee_settings")
}

/// The commission the platform takes on each kind of booking.
model CommissionRate {
  category  BookingCategory @id
  /// As a fraction (0.12 = 12%)
  rate      Decimal         @db.Decimal(5, 4)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("commission_rates")
}
