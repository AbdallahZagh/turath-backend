// Identity service database (turath_identity). Each microservice owns its own
// database; other services refer to users by id only, never by foreign key.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TOURIST
  PROVIDER_STAFF
  PROVIDER_OWNER
  SUPER_ADMIN
}

/// Kind of business a provider account runs. Null for tourists.
enum ProviderType {
  RESTAURANT
  HOTEL
  TRIP_AGENCY
  EVENT_MANAGER
  TOUR_GUIDE
}

enum Locale {
  en
  ar
}

enum Theme {
  light
  dark
  system
}

model User {
  id               String        @id @default(uuid()) @db.Uuid
  /// E.164, e.g. +963944123456
  phone            String        @unique @db.VarChar(20)
  /// ISO 3166-1 alpha-2 of the phone number
  phoneCountry     String?       @map("phone_country") @db.Char(2)
  /// Stored lower-case
  email            String?       @unique @db.VarChar(150)
  /// Null for phone-only accounts
  passwordHash     String?       @map("password_hash")
  fullName         String        @map("full_name") @db.VarChar(100)
  dateOfBirth      DateTime?     @map("date_of_birth") @db.Date
  /// ISO 3166-1 alpha-2
  nationality      String?       @db.Char(2)
  role             UserRole      @default(TOURIST)
  providerType     ProviderType? @map("provider_type")
  /// 0–100, starts at 100, −30 per no-show (see SRS FR-AUTH-04)
  reliabilityScore Int           @default(100) @map("reliability_score")
  preferredLocale  Locale        @default(en) @map("preferred_locale")
  preferredTheme   Theme         @default(system) @map("preferred_theme")
  phoneVerifiedAt  DateTime?     @map("phone_verified_at") @db.Timestamptz(6)
  emailVerifiedAt  DateTime?     @map("email_verified_at") @db.Timestamptz(6)
  lockedAt         DateTime?     @map("locked_at") @db.Timestamptz(6)
  lastLoginAt      DateTime?     @map("last_login_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([role])
  @@map("users")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  SUPPORT
}

/// Back-office staff. Separate from `users`: no phone, no tourist profile.
/// Created only through the private admin API (x-api-key).
model Admin {
  id           String    @id @default(uuid()) @db.Uuid
  fullName     String    @map("full_name") @db.VarChar(100)
  /// Stored lower-case
  email        String    @unique @db.VarChar(150)
  passwordHash String    @map("password_hash")
  role         AdminRole @default(ADMIN)
  /// Values from ADMIN_PERMISSIONS in libs/contracts
  permissions  String[]  @default([])
  lockedAt     DateTime? @map("locked_at") @db.Timestamptz(6)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([role])
  @@map("admins")
}

enum ReviewAbout {
  PROVIDER
  GUEST
}

enum ReviewStatus {
  PUBLISHED
  FLAGGED
  HIDDEN
}

/// A rating left after a booking, moderated from the admin dashboard.
/// Names are copied onto the row so a review still reads correctly if the
/// account changes; `subjectId` / `authorId` link to `users` by id only.
model Review {
  id            String       @id @default(uuid()) @db.Uuid
  about         ReviewAbout
  /// The provider or guest being rated. Null until providers exist as accounts.
  subjectId     String?      @map("subject_id") @db.Uuid
  /// English name of the provider or guest being rated
  subjectName   String       @map("subject_name") @db.VarChar(150)
  authorId      String?      @map("author_id") @db.Uuid
  authorNameEn  String       @map("author_name_en") @db.VarChar(100)
  authorNameAr  String       @map("author_name_ar") @db.VarChar(100)
  /// 1–5
  stars         Int
  bodyEn        String       @map("body_en") @db.VarChar(2000)
  bodyAr        String       @map("body_ar") @db.VarChar(2000)
  /// The booking this review is about (owned by the booking service)
  bookingCode   String       @map("booking_code") @db.VarChar(12)
  status        ReviewStatus @default(PUBLISHED)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([about, subjectId])
  @@index([status])
  @@index([createdAt])
  @@map("reviews")
}

enum BookingCategory {
  HOTELS
  DINING
  TRIPS
  EVENTS
  GUIDES
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
  DISPUTED
}

/// A reservation shown in the admin bookings table. Names and phone are copied
/// onto the row so it still reads correctly if an account changes; `guestId` /
/// `providerId` link to accounts by id only. Amounts are whole Syrian pounds.
model Booking {
  id                String          @id @default(uuid()) @db.Uuid
  /// What the guest shows on arrival, 6 characters (A–Z, 0–9)
  code              String          @unique @db.VarChar(12)
  guestId           String?         @map("guest_id") @db.Uuid
  guestNameEn       String          @map("guest_name_en") @db.VarChar(100)
  guestNameAr       String          @map("guest_name_ar") @db.VarChar(100)
  /// E.164, e.g. +963933441208
  guestPhone        String          @map("guest_phone") @db.VarChar(20)
  /// Null until providers exist as accounts
  providerId        String?         @map("provider_id") @db.Uuid
  providerNameEn    String          @map("provider_name_en") @db.VarChar(150)
  providerNameAr    String          @map("provider_name_ar") @db.VarChar(150)
  category          BookingCategory
  /// First day (check-in, or the day of the visit)
  startDate         DateTime        @map("start_date") @db.Date
  /// Last day, for stays
  endDate           DateTime?       @map("end_date") @db.Date
  /// `HH:mm` (24h), for dining, events and guides
  startTime         String?         @map("start_time") @db.VarChar(5)
  /// What the guest pays, after any discount
  amountSyp         Int             @map("amount_syp")
  couponCode        String?         @map("coupon_code") @db.VarChar(40)
  discountSyp       Int?            @map("discount_syp")
  /// Price before the discount
  originalAmountSyp Int?            @map("original_amount_syp")
  status            BookingStatus   @default(PENDING)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@index([status])
  @@index([category])
  @@index([guestId])
  @@index([guestPhone])
  @@map("bookings")
}
